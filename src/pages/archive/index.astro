---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import fs from 'node:fs';
import path from 'node:path';
const base = import.meta.env.BASE_URL;

// missions 파일 목록
const missionsDir = path.resolve('src/content/missions');
const allMissionFiles = fs.existsSync(missionsDir) ? fs.readdirSync(missionsDir) : [];

const weeks = [
  {
    week: 6,
    title: '하네스와 오케스트레이션',
    members: [
      { name: '다다', cardTitle: '하네스 vs 오케스트레이션 — 개념과 AAA 적용', summary: '두 개념을 강아지 가슴줄 vs 산책 코스로 풀고, AAA 프로젝트에 두 레이어 적용 분석.', detail: '하네스(LLM이 일할 환경)와 오케스트레이션(여러 작업·에이전트를 잇는 흐름)을 햄버거 가게/맥도날드 비유로 구분했다. AAA 프로젝트의 하네스(CLAUDE.md, MEMORY.md, Stop 훅, 권한 화이트리스트)와 오케스트레이션(/publish 내부 5단계, 주간 루틴 4단계)을 구체 사례로 분석. 약점인 "오케스트레이션 수동"을 해결할 GH Actions 자동 분석 + PR 생성 워크플로 설계 포함.', icon: 'extension', link: '' },
      { name: '비비안', cardTitle: '셀피쉬클럽 v4.0 작업 로그', summary: 'selfishclub-ax 레포 분리 + AAA 레포 자동 동기화 인프라 구축.', detail: 'selfishclub-ax 전용 GitHub 레포로 소스코드를 이관하고, GitHub Actions로 AAA 레포에 자동 동기화하는 구조를 만들었다. .gitignore에 Obsidian 파일을 분리해 옵시디언 작업 로그와 코드를 깔끔하게 관리. 4월 한 달간 일자별 작업 로그를 누적했다.', icon: 'engineering', link: 'https://selfishclub-ax.vercel.app' },
      { name: '띵끄', cardTitle: '하네스·오케스트레이션 적용 회고', summary: 'RLS 정책 사전 학습·환경변수·공식문서 = 하네스. OMC team 구조 = 오케스트레이션.', detail: '하네스를 "AI가 다른 곳으로 새지 않게 방향을 잡아주는 것"으로 정의. 본인이 적용한 하네스로 RLS 정책 사전 학습, Vercel 배포 환경변수, API 공식문서 링크 제공을 꼽았다. 오케스트레이션은 OMC를 통한 team 구조(제작자·디자이너·리뷰어, 리뷰어 미승인 시 재작업)로 정리. "하네스는 혼자서도 잘하게, 오케스트레이션은 여럿이 같이 잘하게"라는 한 줄 정리.', icon: 'hub', link: '' },
      { name: '에밀리', cardTitle: '크루 테스트 D-day 알림톡 4종 발송', summary: '취소 버튼·발송 직전 DB 조회·당일 리마인드 로직 완성.', detail: '공유회 당일 4종 알림톡(④당일리마인드, ⑥입장링크, ⑦혜택안내, ⑧시작알림) 발송을 위해 (1) 승인 후 취소 버튼, (2) 발송 시점 DB 재조회, (3) 14:00 당일 리마인드 자동 발송 로직을 구현. 취소 버튼 구현에서 5번 삽질한 과정도 정리.', icon: 'send', link: '' },
      { name: '오웬', cardTitle: '주방 비유로 푼 하네스 + OMC', summary: 'Claude Code = 주방, 커스텀 스킬 = 레시피북, OMC = 동료 요리사들. 컨설팅 클라이언트 이식이 다음 목표.', detail: 'Claude Code를 "내 주방"으로, 스킬을 "레시피북"으로, OMC를 "동료 요리사·플레이팅·검수 친구들"로 비유. 현재는 슈퍼파워 스킬팩 활용 + 반복 작업(외부 제안서, 셀피쉬 포스트)을 커스텀 스킬로 전환 중. Mac mini에 OpenClaw로 24시간 원격 지점 주방 실험. 다음 목표는 컨설팅 클라이언트(플러스모어 등) 회사에 AI 주방을 짓고 넘겨주는 형태로 패키징.', icon: 'restaurant', link: '' },
      { name: '다니', cardTitle: '하네스 엔지니어링 — 인간 병목 빼기', summary: '가시성·강제 게이트·자동 검증 3축으로 인간을 작업 흐름에서 빼는 철학.', detail: 'OpenAI가 5개월간 코드 한 줄 안 치고 AI만으로 서비스를 만든 사례를 인용해 "생산성의 병목은 인간"이라는 결론을 끌어냄. 3축 적용 — ① AI에 "눈" 달기(로그·스크린샷·DOM 스냅샷 기록), ② 강제 게이트(말로 부탁하지 않고 시스템이 어기면 멈추게), ③ 자동 검증(인간 테스트 빼기).', icon: 'visibility', link: '' },
      { name: '흐민', cardTitle: 'Selforge에 하네스 적용', summary: '입력·도구·루프·재시작·외부세계 5요소로 하네스를 분해해 Selforge에 매핑.', detail: '하네스를 "모델의 힘을 실제 일로 전환시키는 전달 구조물"로 정의(어원: 마차의 가죽 장구). 5가지 구성 요소로 분해 — 입력을 모으는 장치, 도구를 집행하는 장치, 루프를 유지하는 장치, 죽어도 다시 살리는 장치, 외부 세계와 잇는 장치. 각각을 Selforge 아키텍처에 매핑.', icon: 'psychology', link: '' },
    ]
  },
  {
    week: 5,
    title: '플랫폼 고도화와 자동화 파이프라인',
    members: [
      { name: '다다', cardTitle: 'AAA 팀 공식 홈페이지 & 어드민', summary: 'Obsidian vault 콘텐츠를 외부에 공개하는 정적 웹사이트 구축.', detail: 'Astro + Vercel로 팀 홈페이지를 만들고, GitHub API를 통해 브라우저에서 직접 frontmatter를 수정할 수 있는 어드민 페이지를 구현. /publish 명령어로 vault 콘텐츠를 자동으로 웹사이트에 배포하는 자동화 시스템까지 완성했다.', icon: 'language', link: 'https://aaa-homepage.vercel.app' },
      { name: '비비안', cardTitle: '셀피쉬클럽 v4.0 플랫폼', summary: 'Webflow 의존성 탈피, Next.js 자체 플랫폼 구축.', detail: 'Next.js + Supabase로 셀피쉬클럽 홈페이지를 새로 개발. 카카오 로그인 인증, 포트원 결제 연동, Webflow 82개 프로그램 마이그레이션까지 완료. 기존 Webflow + Firebase 복잡한 구조를 Next.js + Supabase 단순 구조로 전환했다.', icon: 'shopping_cart', link: 'https://selfishclub-ax.vercel.app' },
      { name: '띵끄', cardTitle: 'GrowthLink — 비즈니스 통합 대시보드 SaaS', summary: 'Stripe·Calendly·GHL·Meta·n8n 5개 서비스 통합. 148커밋.', detail: 'Claude Code로 1개월간 148커밋으로 26개 대시보드 페이지, 67개 API 엔드포인트 구현. 에이전시 운영에 필요한 결제·예약·CRM·광고·워크플로우를 한 곳에서 관리하는 SaaS를 완성했다.', icon: 'dashboard', link: '' },
      { name: '에밀리', cardTitle: 'CRM 자동화 + 멀티채널 카피 생성', summary: '알림톡 9종 자동 발송 + 전채널 카피 자동화 완성.', detail: '공유회 하나당 9종 알림톡을 n8n 크론으로 자동 발송하고, Slack 승인 시스템 구축. 오카방·온드미디어 5종 채널의 카피를 자동 생성하며, 크루 7명 실전 테스트까지 진행 중이다.', icon: 'send', link: '' },
      { name: '오웬', cardTitle: '찜마켓 — 온라인 셀러 맞찜 플랫폼', summary: 'Claude Vision 자동 인증 + 크레딧 경제. 146커밋.', detail: '카카오 로그인, Claude Vision 자동 인증, 응답속도 배지, 크레딧 경제를 갖춘 셀러 커뮤니티 플랫폼을 146커밋으로 구축. WHY가 없던 3주 방황 후 4시간 MVP에서 실제 카페 방장과 사업 협력까지 이어졌다.', icon: 'favorite', link: 'https://zzim-exchange.vercel.app' },
      { name: '흐민', cardTitle: 'Selforge (Personal OS) + Sullivan 영속 세션', summary: '3레이어 아키텍처 설계 + 영속 세션 인프라 구축.', detail: '개인 OS 아키텍처를 3레이어(사고·지식·퍼블리싱)로 설계하고, Sullivan이 재부팅 후에도 자동으로 살아나는 영속 세션 인프라를 구축. Graphify 효율성 검증 시뮬레이션까지 완료했다.', icon: 'psychology', link: '' },
      { name: '다니', cardTitle: 'Remotion + 캐러셀 영상 제작 플랫폼', summary: '코드로 영상 만들기 가이드 + 캐러셀 편집기.', detail: 'Remotion 프레임워크로 Claude Code와 자연어 대화하면서 영상을 제작하는 환경 구축. MP4 녹화 다운로드 기능과 이미지/비디오 높이 자유 조절 기능을 추가하며 비율 왜곡 문제까지 해결했다.', icon: 'movie', link: 'https://zemma-carousel.vercel.app' },
    ]
  },
  {
    week: 4,
    title: '실전 SaaS와 자동화의 완성',
    members: [
      { name: '다다', cardTitle: 'AAA TEAM 공식 홈페이지 + 어드민', summary: 'Obsidian vault 기반 외부 공개 사이트 구축. Vercel 배포.', detail: 'Obsidian vault에 멤버들이 작성한 과제, 인사이트, 도구 정보를 외부에 공개하는 웹사이트를 만들었다. 메인 랜딩, 주간 미션, 인사이트, 도구 모음, 갤러리, AI 분석, 팀소개 등 7개 페이지를 구축하고 Vercel로 배포했다. 어드민 페이지를 추가하여 frontmatter 기반 콘텐츠 관리 시스템을 구현했다.', icon: 'architecture', link: '' },
      { name: '비비안', cardTitle: '셀피쉬클럽 v4.0 — 토큰 효율화 + 인증', summary: 'CLAUDE.md 정비 + BetterAuth 카카오 로그인 구축. 하네스 엔지니어링으로 토큰 효율화.', detail: 'Claude Code가 읽는 설정 파일들을 정비하여 토큰 효율화를 선행했다. CLAUDE.md에 현재 진행 상황 섹션을 추가하고, AGENTS.md에 서브에이전트용 절대 규칙을 추가했다. BetterAuth + 카카오 OAuth를 연결하고 Supabase DB에 인증 테이블 4개를 생성했다. selfishclub-ax 전용 GitHub 레포를 연결하고 GitHub Actions 자동 동기화를 설정했다.', icon: 'engineering', link: '' },
      { name: '띵끄', cardTitle: 'GrowthLink — 비즈니스 통합 대시보드', summary: '148커밋, 26페이지, 67 API. Stripe·Calendly·GHL·Meta·n8n 5개 서비스 통합.', detail: '에이전시 사업 운영에 필요한 5~6개 툴(Stripe, Calendly, GoHighLevel, Meta, n8n)을 하나의 대시보드에서 통합 관리하는 SaaS GrowthLink(구 YFLOW)를 완성했다. 약 1개월간 148커밋, 26개 대시보드 페이지, 67개 API 엔드포인트, 20개+ DB 테이블을 구축했다. AI 인스타그램 캐러셀 생성기와 High-Ticket OS를 핵심 기능으로 포함했다.', icon: 'code', link: '' },
      { name: '에밀리', cardTitle: 'CRM 알림톡 9종 자동 발송 완성', summary: '알림톡 9종 + 카플친·오카방·온드미디어 카피 자동화. 크루 7명 실전 테스트.', detail: '공유회 하나당 각기 다른 템플릿 알림톡 9종(오픈알림, 리마인드, D-1, 당일, 할인쿠폰, 입장링크, 시작알림, 혜택안내, VOD)을 자동 발송하는 시스템을 완성했다. n8n 크론이 매일 아침 10시에 오늘 나가야 할 알림톡을 자동 확인한다. 카플친·오카방·온드미디어 카피 자동화와 랜딩페이지 작업까지 확장했다.', icon: 'campaign', link: '' },
      { name: '오웬', cardTitle: '찜마켓 — 146커밋 안전 맞찜 플랫폼', summary: 'AI 스크린샷 인증 + 크레딧 경제 + 셀러 커뮤니티. Microsoft Clarity 분석.', detail: '에이블리/지그재그/무신사 셀러 전용 안전 맞찜 플랫폼 찜마켓을 146커밋(feat 78/fix 57)으로 완성했다. 맞찜 전체 플로우(요청→수락→인증→AI 검증→완료), Claude Vision AI 스크린샷 자동 인증, 크레딧 경제 시스템, 셀러 커뮤니티, 실시간 알림을 구현했다. Microsoft Clarity 히트맵/세션리플레이로 분석 환경을 세팅했다.', icon: 'photo_camera', link: 'https://zzim-exchange.vercel.app' },
      { name: '흐민', cardTitle: 'Personal OS + Sullivan 마이그레이션', summary: 'Claude-Channel 마이그레이션. 3레이어 아키텍처 설계. 영속 세션 인프라.', detail: 'Sullivan의 동작 구조를 Claude-Channel 기능으로 마이그레이션하고, 재부팅 후에도 Sullivan이 자동으로 살아나는 영속 세션 인프라를 구축했다. Personal OS를 3레이어 아키텍처(사고·지식·퍼블리싱)로 설계하고, Karpathy LLM Wiki + Graphify를 리서치하여 적용했다. OmC Deep-Interview를 통해 요구사항을 구체화하고 리브랜딩했다.', icon: 'psychology', link: '' },
      { name: '다니', cardTitle: 'Remotion — 터미널에서 영상 만들기', summary: 'React + Claude Code로 자연어 영상 제작. 30~40분이면 첫 영상 완성.', detail: 'Remotion(React로 영상을 만드는 프레임워크)과 Claude Code를 결합하여 터미널에서 자연어로 영상을 만드는 워크플로우를 구축했다. After Effects나 프리미어 없이, 코드 한 줄도 안 건드리고 "이런 영상 만들어줘"라고 대화하면 AI가 코드를 짜고 브라우저에서 실시간 미리보기를 확인하며 수정할 수 있다. 총 30~40분이면 첫 영상까지 완성 가능.', icon: 'smart_toy', link: '' },
    ]
  },
  {
    week: 3,
    title: '자동화를 넘어 실제 서비스 배포',
    members: [
      { name: '다다', cardTitle: '스터디 운영시스템 + 웹사이트 구축', summary: '커스텀 스킬 5개 생성. Quartz에서 Astro로 마이그레이션. 도구의 한계를 먼저 파악하는 것이 중요하다는 인사이트.', detail: '약 6~7시간에 걸쳐 스터디 운영시스템을 설계하고 웹사이트를 구축했다. 커스텀 슬래시 명령어 5개(/analyze, /propose, /ln, /archive, /publish)를 만들어 운영 자동화를 구현했다. Quartz로 시작했으나 CSS 충돌이 반복되어 Astro로 마이그레이션했다. 핵심 인사이트: 증상(디자인 깨짐)만 보고 코드를 계속 고치지 말고, 도구 자체의 한계인지 먼저 의심해보자.', icon: 'architecture', link: '' },
      { name: '비비안', cardTitle: '셀피쉬클럽 v4.0 자체 플랫폼 셋업', summary: 'Webflow 의존을 끊고 Next.js 기반 자체 플랫폼 구축. BRIEFING.md + CLAUDE.md + DESIGN.md로 문서 우선 개발.', detail: '셀피쉬클럽 v4.0 리뉴얼을 위해 Webflow 의존을 끊고 Next.js 기반 자체 플랫폼을 구축하기 위한 초기 셋업을 완료했다. BRIEFING.md로 전체 기획을 Claude에게 전달하고, CLAUDE.md로 코딩 컨벤션을, DESIGN.md로 디자인 시스템을 정의했다. 기술 스택은 Next.js 16 + TypeScript + Tailwind CSS v4 + Vercel.', icon: 'engineering', link: '' },
      { name: '띵끄', cardTitle: 'YFLOW 전체 감사 — 5개 에이전트 동시 투입', summary: '5개 스프린트로 보안/성능/품질/접근성/구조 분석. God Component 2,188줄→186줄. Vitest 31개 테스트.', detail: 'team 5 명령으로 5개 전문 에이전트(Security, Performance, Code Review, A11y, Architecture)를 동시에 투입해 YFLOW 프로젝트를 전체 감사했다. 5개 스프린트로 나눠 보안 기반 → API 안전성 → 안정성 → 성능 → 접근성+테스트 순서로 진행했다. God Component 2,188줄을 186줄로 분리하고 Vitest 31개 테스트를 작성했다.', icon: 'code', link: 'https://github.com/growththink/flowops-dashboard' },
      { name: '에밀리', cardTitle: 'CRM 알림톡 실제 발송 자동화', summary: 'n8n 알림톡 ①~⑤ 전체 플로우 성공. 맥북 꺼져도 발송되는 하이브리드 아키텍처 재설계. PRD 8개 분리.', detail: '2주차에 만든 CRM 자동화를 실제 발송까지 연결했다. 맥북이 꺼져도 알림톡이 나가도록 n8n(서버)과 Claude Code(로컬)를 하이브리드로 재설계했다. n8n 크론을 재설계하여 줌링크 하나만 넣으면 나머지 4개 알림톡에서 자동 재사용하는 구조를 만들었다. CLAUDE.md 372줄을 PRD 8개로 분리하여 에이전트가 자기 채널만 읽도록 개선했다.', icon: 'campaign', link: '' },
      { name: '오웬', cardTitle: '찜마켓 — 안전한 맞찜 플랫폼', summary: '카카오 로그인 + 스크린샷 인증 + 신뢰 온도 + 크레딧 시스템. /briefing, /timecheck 스킬 2개 제작.', detail: '에이블리/지그재그/무신사 셀러를 위한 안전한 맞찜 플랫폼 \'찜마켓\'을 구축했다. 카카오 로그인, 스크린샷 인증, 당근 매너온도 방식의 신뢰 온도, 24시간 자동 환불 시스템을 구현했다. /briefing(자동 브리핑)과 /timecheck(작업 시간 추적) 스킬 2개를 제작하여 GitHub에 공개했다. 핵심 인사이트: 클로드의 위험성은 내가 똑똑한 것 아닐까라는 착각을 하게 되는 것.', icon: 'photo_camera', link: 'https://zzim-exchange.vercel.app' },
      { name: '흐민', cardTitle: 'Sullivan + Personal Brand OS', summary: 'Capture 에이전트 강화 + Agent Mode 추가. Python→마크다운 에이전트 전환. 오픈클로 + 로컬 LLM 연구.', detail: 'Sullivan의 Capture 에이전트를 대폭 강화하고 Agent Mode를 추가했다. 코드 레벨에서 대응 불가한 케이스에서 에러 대신 Agent를 호출하여 자동 해결하도록 세팅했다. Personal Brand OS를 구축하여 Obsidian 노트, 사진 등의 소스를 기반으로 다양한 플랫폼별 콘텐츠를 자동 생성하는 멀티에이전트 시스템을 만들었다. Python + Claude SDK에서 .claude/agents/*.md 마크다운 방식으로 전환했다.', icon: 'psychology', link: '' },
    ]
  },
  {
    week: 2,
    title: '원소스 멀티유즈의 폭발',
    members: [
      { name: '비비안', cardTitle: 'Webflow→Next.js 마이그레이션 설계', summary: '9단계로 체계적 분석. Supabase 락인 해결, Auth 방식 결정, 어드민 스펙 확정.', detail: '기존 Webflow 사이트의 구조, 페이지 목록, URL 패턴부터 분석하고 Supabase 락인 문제, Auth 방식, 결제 연동까지 하나씩 풀어나갔다. Magic Link에서 Clerk + 카카오 소셜 로그인으로 전환을 확정했다. 9단계에 걸친 체계적 분석 후 CLAUDE.md를 작성했다.', icon: 'engineering', link: '' },
      { name: '띵끄', cardTitle: '원소스 멀티유즈 콘텐츠 마케팅 사이트', summary: 'OMC 활용, Vercel 자동배포, YouTube API 연동. 비용관리 자동화.', detail: '콘텐츠 마케팅 사이트를 제작하고 GitHub + Vercel 연결로 자동 배포를 구현했다. YouTube API를 연동하고 OMC를 활용하여 비용관리 자동화(영수증→비용처리)를 시도했다.', icon: 'code', link: 'https://content-marketing-team.vercel.app/' },
      { name: '잽', cardTitle: 'BRAND SHOW UP 원페이지 웹 제안서', summary: '프레임워크 없이 순수 HTML/CSS/JS로 하루 만에 완성. GitHub Pages 배포.', detail: '에이빙뉴스의 브랜드 홍보 프로젝트 BRAND SHOW UP을 소개하는 원페이지 웹 제안서를 제작했다. 외부 라이브러리 없이 순수 HTML/CSS/JS만으로 프리미엄 결과물을 완성했다. Claude Code와 실시간 페어 프로그래밍으로 하루 만에 기획→디자인→개발→배포를 완료했다.', icon: 'web', link: 'https://zap-arch.github.io/brand-showup/' },
      { name: '흐민', cardTitle: 'Sullivan — 질문하는 AI 어시스턴트', summary: '5개 Agent + Obsidian 연동 + 자동 스케줄러. Anne Sullivan 교육 철학 적용.', detail: '피드가 호기심의 주도권을 가져간다는 문제의식에서 Sullivan 프로젝트를 시작했다. 정보를 더 주는 AI가 아니라 질문을 던져서 생각을 확장하는 AI를 설계했다. Anne Sullivan의 교육 철학을 AI 설계 원칙으로 적용했다.', icon: 'psychology', link: '' },
      { name: '에밀리', cardTitle: 'CRM 자동화 — 8채널 20개 콘텐츠', summary: 'URL 하나로 알림톡+카플친+오픈채팅+인스타+이메일+UTM 자동 생성. 6개 에이전트 팀.', detail: '공유회 URL 하나를 입력하면 알림톡 9종, 카플친 배너 3종, 오픈채팅 카피 9개, 인스타 캐러셀 5장, 이메일, UTM 21개를 자동 생성하는 시스템을 구축했다. 6개 에이전트(director, data-collector, timeline-planner, copywriter, media-ops, dispatcher) 팀 구조를 설계했다.', icon: 'campaign', link: '' },
      { name: '다니', cardTitle: '원소스 멀티유즈 3채널 자동 생성', summary: 'URL로 인스타 캐러셀 + 스레드 + 링크드인 콘텐츠 동시 생성. OpenCode 비교 분석.', detail: 'YouTube 영상 URL 하나를 입력하면 인스타 캐러셀, 스레드, 링크드인 포스트를 동시에 생성하는 원소스 멀티유즈 시스템을 만들었다. Claude Code vs OpenCode 오픈소스 대안도 비교 분석했다.', icon: 'smart_toy', link: '' },
      { name: '오웬', cardTitle: '인스타그램 카드뉴스 완전 자동화', summary: 'crontab으로 매주 월/목 자동 실행. Claude API + Playwright + instagrapi.', detail: '온라인 셀러를 위한 AI 정보 계정 @aisellerguide를 운영하면서 카드뉴스 자동 제작 시스템을 구축했다. Claude API로 리서치 → HTML 템플릿 → Playwright PNG 변환 → instagrapi 자동 업로드 파이프라인을 만들었다. crontab으로 매주 월/목 12:38 자동 실행.', icon: 'photo_camera', link: '' },
    ]
  },
  {
    week: 1,
    title: 'AI 파이프라인 설계',
    members: [
      { name: 'Alex', cardTitle: '팀 운영 자동화 슬래시 명령어', summary: 'Claude Code 슬래시 명령어 4개로 30분 내 배포 구조 완성.', detail: 'Claude Code 슬래시 명령어 4개를 만들어서 팀 운영을 자동화했다. 매주 회의 끝나고 /analyze 한 번이면 분석 리포트 + 멤버 프로필 + 현황표가 한꺼번에 갱신된다. 배포까지 30분 안에 끝나는 구조를 완성. 2-repo 구조에서 비공개 폴더가 공개 사이트로 넘어가는 것을 방지하기 위해 sync-content.sh에 화이트리스트 방식을 적용했다.', icon: 'terminal', link: '' },
      { name: 'Haru', cardTitle: 'AI 브랜딩 워크플로우 설계', summary: 'Midjourney + Claude + Figma 3단계 프로세스. 5분 만에 시안 5개 확인.', detail: 'Midjourney로 로고 시안 5종 생성 → Claude로 브랜드 가이드라인 문서 자동 작성 → Figma에서 최종 편집하는 3단계 프로세스를 설계했다. 가상의 커피숍 브랜드 "모닝라운지"를 대상으로 실제 적용. AI 디자인 도구의 진짜 가치는 최종 결과물이 아니라 탐색 범위를 넓히는 것이라는 인사이트를 발견했다.', icon: 'palette', link: '' },
      { name: 'Jay', cardTitle: 'n8n 뉴스봇 + 카카오톡 자동 발송', summary: 'RSS → Claude 요약 → 카카오톡 알림톡. 월 $2 이하, 열람률 95%.', detail: 'n8n 워크플로우로 매일 아침 AI 뉴스를 자동 수집해서 카카오톡 채널로 보내주는 봇을 만들었다. RSS 3개 소스에서 기사를 가져오고, Claude API로 한국어 3줄 요약을 생성한 뒤, 카카오톡 알림톡으로 발송하는 파이프라인. 기사 원문 대신 첫 500자만 넣어 비용을 5배 절감했다.', icon: 'rss_feed', link: '' },
      { name: 'Luna', cardTitle: 'GitHub PR 자동 코드 리뷰 봇', summary: 'GitHub Actions + Claude API. 보안·성능·스타일 자동 검증, 오탐률 60% 감소.', detail: 'PR이 올라오면 자동으로 코드 리뷰를 해주는 봇을 만들었다. PR diff를 읽고 보안 취약점, 성능 이슈, 코드 스타일 위반을 잡아주는 시스템. 프롬프트에 "확실하지 않으면 지적하지 마라"를 넣는 것만으로 오탐률이 60% 감소. Cursor Rules와 Claude API 프롬프트를 통일하면 로컬 가이드 + PR 검증이 일관되게 동작한다.', icon: 'code', link: '' },
    ]
  },
];
---
<Layout title="아카이브 - AAA 아카이브">
  <!-- Hero Banner -->
  <section class="pt-20 md:pt-24" style="background: linear-gradient(135deg, rgba(251,232,48,0.08) 0%, rgba(251,232,48,0.15) 40%, rgba(200,240,200,0.1) 100%);">
    <div class="max-w-screen-2xl mx-auto px-6 md:px-12 pt-8 md:pt-10 pb-8 md:pb-10">
      <h1 class="font-headline text-2xl md:text-3xl font-extrabold tracking-tight text-black dark:text-white mb-2">주간 미션</h1>
      <p class="text-sm md:text-base text-slate-600 dark:text-gray-400 mb-4">매주 <strong class="text-black dark:text-white">만들고 배운 것들</strong>의 기록. 아이디어가 프로젝트가 되는 과정.</p>
      <div class="flex flex-wrap gap-2">
        <span class="px-3 py-1 text-xs font-medium border border-slate-200 dark:border-[#353437] rounded-full text-slate-600 dark:text-gray-400 bg-white/60 dark:bg-[#1b1b1d]/60">#주간과제</span>
        <span class="px-3 py-1 text-xs font-medium border border-slate-200 dark:border-[#353437] rounded-full text-slate-600 dark:text-gray-400 bg-white/60 dark:bg-[#1b1b1d]/60">#빌드로그</span>
        <span class="px-3 py-1 text-xs font-medium border border-slate-200 dark:border-[#353437] rounded-full text-slate-600 dark:text-gray-400 bg-white/60 dark:bg-[#1b1b1d]/60">#실전배포</span>
      </div>
    </div>
  </section>

  <!-- Weekly Archive -->
  <section class="pt-10 md:pt-12 pb-24 px-6 md:px-12 max-w-screen-2xl mx-auto">
    {weeks.map((week) => (
      <div class="mb-20">
        <div class="flex items-baseline gap-4 mb-8">
          <span class="text-4xl font-headline font-black text-[#FBE830]">W{String(week.week).padStart(2, '0')}</span>
          <div>
            <h2 class="text-xl md:text-2xl font-bold text-black dark:text-white tracking-tight">{week.title}</h2>
            <p class="text-sm text-slate-400 dark:text-gray-500">{week.members.length}명 참여</p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {week.members.map((member) => {
            const missionFile = `Week_0${week.week}_${member.name}`;
            const hasMission = allMissionFiles.includes(`${missionFile}.md`);
            const missionId = missionFile.toLowerCase();
            const CardTag = hasMission ? 'a' : 'div';
            return (
            <CardTag
              href={hasMission ? `${base}missions/${missionId}/` : undefined}
              class={`p-6 bg-slate-50 dark:bg-[#1b1b1d] border border-slate-100 dark:border-[#353437] rounded-xl hover:border-[#FBE830]/30 hover:shadow-lg transition-all group flex flex-col ${hasMission ? 'cursor-pointer' : 'opacity-60'}`}
            >
              <h3 class="font-headline text-base font-bold text-black dark:text-white mb-2 group-hover:text-[#d4a800] dark:group-hover:text-[#FBE830] transition-colors line-clamp-1">{member.cardTitle || member.summary}</h3>
              <p class="text-sm text-slate-500 dark:text-gray-400 leading-relaxed mb-4 line-clamp-2 flex-1">{member.summary}</p>
              <div class="flex items-center justify-between pt-3 border-t border-slate-100 dark:border-[#353437]">
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 bg-white dark:bg-[#2a2a2c] rounded-full flex items-center justify-center">
                    <span class="text-[9px] font-bold text-slate-500 dark:text-gray-400">{member.name.charAt(0)}</span>
                  </div>
                  <span class="text-xs text-slate-400 dark:text-gray-500">by {member.name}</span>
                </div>
                {hasMission && (
                  <span class="material-symbols-outlined text-slate-300 dark:text-gray-600 text-sm group-hover:text-[#FBE830] transition-colors">arrow_forward</span>
                )}
              </div>
            </CardTag>
          );
          })}
        </div>
      </div>
    ))}
  </section>

</Layout>
